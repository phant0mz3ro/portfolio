---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const notes = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title="Notes — Daniel" description="Shorter notes, learnings, and thoughts — not tied to a specific project.">
  <section class="hero wrap">
    <h1>Notes</h1>
    <p class="tagline">
      Shorter write-ups — things I learned, ideas I'm chewing on, links worth
      keeping. Not tied to a specific project.
    </p>
  </section>

  <section class="wrap">
    <div class="notes-list">
      {notes.map((note) => (
        <article class="note-row">
          <span class="note-date">{dateFmt(note.data.date)}</span>
          <div>
            <h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
            {note.data.summary && <p class="summary">{note.data.summary}</p>}
            {note.data.tags.length > 0 && (
              <div class="tag-row">
                {note.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
        </article>
      ))}
      {notes.length === 0 && <p style="color: var(--text-dim);">No notes yet.</p>}
    </div>
  </section>
</Layout>
